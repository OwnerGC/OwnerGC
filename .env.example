# Copy this file to .env.local and fill in the values.
# For local development, `npx supabase status` prints the URL and anon key.
# For production, they are in the Supabase dashboard under Project Settings > API,
# and are entered in Vercel under Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed to turn on Google sign-in locally (see README). Never commit real values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
